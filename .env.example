# LLM
LLM_PROVIDER=qwen
LLM_MODEL=qwen3.7-flash
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=platform
DB_PASSWORD=platform_dev
DB_NAME=enterprise_agent_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=platform-files

# pgvector (PostgreSQL 16 + pgvector extension)
DATABASE_URL=postgresql://platform:platform_dev@localhost:5432/enterprise_agent_platform
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# JWT
JWT_SECRET=<SET-A-STRONG-RANDOM-SECRET>
JWT_EXPIRATION_HOURS=24

# Go Backend
GO_SERVER_PORT=8080
GO_SERVER_MODE=debug
FILE_STORAGE_DIR=storage/files
STRICT_DOMAIN_POLICY=false
# V1 桥失联判定阈值:超过该时长的非终态 Durable Run 会被重驱动/收敛扫描接管
AGENT_RUN_STALE_AFTER=10m
# Workflow Worker agent_graph 执行路径(M2-A):true=Runtime V2 异步(StartV2+
# 事件推进,终态事件携带 output/usage);false=V1 同步桥。Go 侧默认 false,
# docker-compose 演示环境默认 true
WORKER_RUNTIME_V2=true

# Tool Execution(M2-C/D)
# executing→indeterminate 超时阈值与扫描周期
TOOL_CALL_DEFAULT_TIMEOUT=2m
TOOL_CALL_TIMEOUT_SCAN_EVERY=15s
# 重试上限:达到后 tool_call 进入死信队列(is_dead_letter=true)
TOOL_CALL_MAX_RETRY=3
# 连续失败熔断阈值与冷却期(冷却期满后半开放行单探测)
TOOL_CIRCUIT_FAILURE_THRESHOLD=5
TOOL_CIRCUIT_COOLDOWN=60s
# Connector 凭证加密密钥(SHA-256 域分隔派生 AES-256-GCM key);生产必须覆盖
TOOL_SECRET_ENCRYPTION_KEY=<SET-A-32BYTE-HEX-KEY>

# Connector Webhook Inbox(M3-B)
# 外部推送 HMAC-SHA256 签名密钥(X-Signature 头校验);生产必须覆盖
TOOL_WEBHOOK_SECRET=change-me-webhook-secret
# WebhookConsumer 消费周期
TOOL_WEBHOOK_SCAN_EVERY=10s

# Python Agent Service
AGENT_SERVICE_PORT=8000
AGENT_SERVICE_URL=http://agent-service:8000
INTERNAL_SERVICE_TOKEN=<SET-A-STRONG-RANDOM-TOKEN>
FILE_SERVICE_URL=http://go-backend:8080
# Agent Runtime 存储后端(ADR-009):
#   RUNTIME_DATABASE_URL 设置即启用 PostgreSQL(checkpoint + runtime_v2_* 表,
#   schema agent_runtime);留空则回退本地 SQLite(CHECKPOINT_DB_PATH)。
#   也可用 RUNTIME_STORE_BACKEND=postgres 回退复用 DATABASE_URL。
RUNTIME_DATABASE_URL=postgresql://platform:platform_dev@localhost:5432/enterprise_agent_platform
# RUNTIME_STORE_BACKEND=postgres
# SQLite 回退路径(仅 RUNTIME_DATABASE_URL 未设置时生效)
CHECKPOINT_DB_PATH=/tmp/enterprise-agent-platform/agent-checkpoints.sqlite3

# Frontend
VITE_API_BASE_URL=http://localhost:8080
